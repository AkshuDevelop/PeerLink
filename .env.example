# ====================================================================
# PEERLINK — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to server/.env (or set these in Render / Railway).
# ====================================================================

# --------------------------------------------------------------------
# 1. MongoDB Database URI
# --------------------------------------------------------------------
# Local Development (Optional):
#   If left commented out or blank, PeerLink automatically starts an
#   in-memory MongoMemoryServer so you can develop with zero setup.
#
# Production / Persistent Cloud (MongoDB Atlas Free M0 Tier):
#   Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
#   Note: If your password contains special characters (@, :, /, #), URL-encode them.
#
# MONGODB_URI=mongodb+srv://peerlink_admin:YourStrongPassword123@cluster0.abcde.mongodb.net/peerlink?retryWrites=true&w=majority

# --------------------------------------------------------------------
# 2. JWT Authentication Secret
# --------------------------------------------------------------------
# Secret used to sign and verify JSON Web Tokens for user login sessions.
# In production, use a long, cryptographically random string (min 32 chars).
JWT_SECRET=peerlink_super_secret_jwt_key_change_in_production_min32chars

# --------------------------------------------------------------------
# 3. Server Port
# --------------------------------------------------------------------
# Defaults to 4000 locally. On Render / Heroku / Railway, $PORT is set automatically.
PORT=4000

# --------------------------------------------------------------------
# 4. Node Environment
# --------------------------------------------------------------------
# Set to 'production' on cloud hosts so Express serves compiled client assets.
NODE_ENV=development

# --------------------------------------------------------------------
# 5. Client Build Output Path (Production Only)
# --------------------------------------------------------------------
# Path where `npm run build --prefix client` puts static assets.
CLIENT_DIST_PATH=../client/dist

# --------------------------------------------------------------------
# 6. CORS / Allowed Origins (Optional)
# --------------------------------------------------------------------
# By default, in production PeerLink reflects incoming origin.
# To restrict access to specific domains, provide a comma-separated list:
# CORS_ORIGIN=https://peerlink.onrender.com,https://yourdomain.com

# --------------------------------------------------------------------
# 7. Optional TURN Relay Credentials (for restrictive corporate NATs)
# --------------------------------------------------------------------
# Google's public STUN servers (stun:stun.l.google.com:19302) are used by default.
# If peers cannot connect due to symmetric enterprise NATs, add a TURN server:
# VITE_TURN_URL=turn:your.turn.server:3478
# VITE_TURN_USERNAME=your_username
# VITE_TURN_CREDENTIAL=your_password
